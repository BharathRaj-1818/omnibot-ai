# Backend API Configuration
API_BASE_URL=http://localhost:8000

# Telegram Bot (Get token from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord Bot (Get from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# WhatsApp/Twilio (Optional - Get from https://www.twilio.com/)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Hugging Face Token (Optional - for faster model downloads)
# Get from https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Database
DATABASE_URL=sqlite:///./omnibot.db

# Frontend
REACT_APP_API_URL=http://localhost:8000
